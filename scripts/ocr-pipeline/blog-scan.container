[Unit]
Description=Scan pipeline sidecar — Phase 9 rsync pull + OCR + draft creation

[Container]
Image=localhost/blog-scan:latest
ContainerName=blog-scan
Pod=blog.pod
Volume=blog-content:/site/content
Volume=~/.local/share/blog-scans/inbox:/inbox:z
Volume=~/.local/share/blog-scans/processed:/processed:z
Volume=~/.local/share/blog-scans/failed:/failed:z
Volume=~/.local/share/blog-scans/state:/var/lib/scan:z
Volume=~/.config/blog-scan/rsyncd.password:/etc/rsyncd.password:ro,z

[Service]
Restart=always

[Install]
WantedBy=default.target