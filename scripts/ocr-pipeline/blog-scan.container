[Unit]
Description=Scan pipeline sidecar — Phase 9 rsync pull + OCR + draft creation

[Container]
Image=localhost/blog-scan:latest
ContainerName=blog-scan
Pod=blog.pod
SecurityLabelDisable=true
Volume=blog-content:/site
# Absolute paths required — podman parses the source side of a Volume=
# directive as a named-volume name, and rejects `~` and `..` segments.
# Tilde expansion only works inside shell command lines, not in quadlet
# syntax. See Phase 9 §9.8 deployment pitfalls.
Volume=/home/hermes/.local/share/blog-scans/inbox:/inbox:z
Volume=/home/hermes/.local/share/blog-scans/processed:/processed:z
Volume=/home/hermes/.local/share/blog-scans/failed:/failed:z
Volume=/home/hermes/.local/share/blog-scans/state:/var/lib/scan:z
Volume=/home/hermes/.config/blog-scan/rsyncd.password:/etc/rsyncd.password:ro,z
Environment=SCAN_OCR_PROVIDERS=ollama,hermes,tesseract
Environment=OLLAMA_OCR_URL=http://192.168.0.8:11434
Environment=OLLAMA_OCR_MODEL=hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
Environment=OLLAMA_OCR_TIMEOUT=300
Environment=OLLAMA_OCR_CONTEXT=8192

# Tier-2: locked-down Hermes OCR profile (Nous Llama 4 Maverick).
# The ocr-profile gateway listens on :8644 with api_server toolset
# disabled — it can only echo back OCR transcriptions, nothing more.
# HERMES_OCR_PROMPT is the clean tight instruction sent with every
# image (see /opt/data/documentation/homelab/ocr-profile-restoration.md).
Environment=HERMES_OCR_URL=http://127.0.0.1:8644/v1
Environment=HERMES_OCR_API_KEY=gLtcqY9CSGKPjSbp40Ns9bsOdPS4kZRpNYEHOaWxzZU
Environment=HERMES_OCR_MODEL=hermes-ocr
Environment=HERMES_OCR_TIMEOUT=120
Environment=HERMES_OCR_PROMPT=OCR. Output the literal text on this page, preserving line breaks. No commentary, no formatting, no Q&A. Just the words.

# rsync:// URL — Synology exposes the NAS shared folder as an rsync module
# named "NAS", with the scan PDFs at /volume1/NAS/blog-scans/ on the server.
# Trailing slash on the path makes rsync treat it as a directory so files
# land directly in /inbox/.
#
# Auth: rsync daemon uses the password from /etc/rsyncd.password via
#       --password-file (handled inside rsync_and_process.sh).
#
# SSH-style rsync (user@host:/path/) was attempted first but the Synology's
# autobot account is sftp-only and refuses to spawn rsync over SSH.
Environment=SCAN_NAS_URL=rsync://autobot@192.168.0.160/NAS/blog-scans/

[Service]
Restart=always

[Install]
WantedBy=default.target